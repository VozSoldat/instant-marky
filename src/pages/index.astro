---
import Layout from "../layouts/layout.astro";
---

<Layout title="InstantMarky - Publish Instantly">
  <main class="max-w-4xl mx-auto p-6">
    <article
      id="viewer"
      class="hidden prose prose-slate lg:prose-xl max-w-none"
    >
    </article>

    <div id="view-controls" class="hidden flex gap-4 border-t pt-6 mt-10">
      <button
        id="edit-btn"
        class="flex-1 bg-slate-800 text-white px-6 py-2 rounded-lg hover:bg-slate-900 transition flex items-center justify-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          height="24px"
          viewBox="0 -960 960 960"
          width="24px"
          fill="#e8eaed"
          ><path
            d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"
          ></path></svg
        >
        Edit Konten
      </button>
      <button
        id="reset-btn"
        class="bg-red-50 text-red-600 px-6 py-2 rounded-lg hover:bg-red-100 transition border border-red-200 flex items-center justify-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          height="24px"
          viewBox="0 -960 960 960"
          width="24px"
          fill="#e53e3e"
          ><path
            d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
          ></path></svg
        >
        Hapus & Baru
      </button>
    </div>

    <div id="editor-container" class="space-y-4">
      <p class="text-gray-600">
        Ketik markdown di bawah. Link di address bar akan terupdate otomatis.
      </p>
      <textarea
        id="markdown-input"
        class="w-full h-96 p-4 border rounded-lg font-mono focus:ring-2 focus:ring-blue-500 outline-none"
        placeholder="# Judul Markdown Anda..."></textarea>

      <div class="flex items-center gap-4">
        <button
          id="copy-btn"
          class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition"
        >
          Salin Link Publikasi
        </button>
        <span id="char-count" class="text-sm text-gray-500">0 karakter</span>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { Engine } from "../lib/engine";

  const textarea = document.getElementById(
    "markdown-input",
  ) as HTMLTextAreaElement;
  const viewer = document.getElementById("viewer");
  const editorContainer = document.getElementById("editor-container");
  const viewControls = document.getElementById("view-controls");
  const charCount = document.getElementById("char-count");
  const copyBtn = document.getElementById("copy-btn");
  const editBtn = document.getElementById("edit-btn");
  const resetBtn = document.getElementById("reset-btn");

  // Fungsi untuk beralih ke Mode Editor
  function showEditor(withContent = true) {
    if (!withContent) {
      textarea.value = "";
      window.history.replaceState(null, "", window.location.pathname); // Bersihkan hash
    }
    viewer?.classList.add("hidden");
    viewControls?.classList.add("hidden");
    editorContainer?.classList.remove("hidden");
  }

  // Fungsi untuk beralih ke Mode View (Render)
  async function showView(hashData: string) {
    const decoded = Engine.decode(hashData);
    if (decoded && viewer && editorContainer && viewControls) {
      textarea.value = decoded;
      viewer.innerHTML = await Engine.render(decoded);

      editorContainer.classList.add("hidden");
      viewer.classList.remove("hidden");
      viewControls.classList.remove("hidden");
    }
  }

  // 1. Inisialisasi: Cek URL saat load
  const init = () => {
    const hash = window.location.hash.slice(1);
    if (hash.startsWith("data=")) {
      showView(hash.replace("data=", ""));
    }
  };
  init();

  // 2. Event Listeners
  editBtn?.addEventListener("click", () => showEditor(true));

  resetBtn?.addEventListener("click", () => {
    if (confirm("Hapus semua konten dan buat baru?")) {
      showEditor(false);
    }
  });

  textarea?.addEventListener("input", (e) => {
    const text = (e.target as HTMLTextAreaElement).value;
    const compressed = Engine.encode(text);
    if (charCount)
      charCount.innerText = `${compressed.length} characters in URL`;

    // Update URL secara realtime
    window.history.replaceState(null, "", `#data=${compressed}`);
  });

  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText(window.location.href);
    if (copyBtn) {
      const originalText = copyBtn.innerText;
      copyBtn.innerText = "Tersalin!";
      setTimeout(() => (copyBtn.innerText = originalText), 2000);
    }
  });
</script>
